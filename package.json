{
  "name": "lammb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @lammb/web",
    "start": "npm run start --workspace @lammb/web",
    "build": "npm run build --workspace @lammb/web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "collection:generate": "node --experimental-strip-types packages/art-generator/src/cli.ts generate",
    "collection:verify": "node --experimental-strip-types packages/art-generator/src/cli.ts verify",
    "collection:summarize": "node --experimental-strip-types packages/art-generator/src/cli.ts summarize",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "collection:art:validate": "node --experimental-strip-types packages/art-generator/src/art-cli.ts validate",
    "collection:plan": "node --experimental-strip-types packages/art-generator/src/art-cli.ts plan",
    "collection:render-fixture": "node --experimental-strip-types packages/art-generator/src/art-cli.ts render-fixture",
    "collection:art:readiness": "node --experimental-strip-types packages/art-generator/src/art-cli.ts readiness"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "d3-geo": "3.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
