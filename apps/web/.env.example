# Server-only examples. OFF by default; never paste real credentials in Git.
GENESIS_REGISTRATION_ENABLED=false
GENESIS_ADMIN_ENABLED=false
GENESIS_ORIGIN=https://lammb.fun
# Requires a separate owner-approved activation review digest.
GENESIS_ACTIVATION_REFERENCE=
# Netlify supplies NETLIFY_DB_URL to @netlify/database for the current branch.
# Do not set or copy that provider credential manually. Native request handling
# replaces its owner login with the SQL-created lammb_genesis_runtime login.
# Generate 32 random bytes privately; no secret in Git, NEXT_PUBLIC_ or previews.
GENESIS_DATABASE_PASSWORD=
# Standalone/local PostgreSQL only. MUST remain empty on Netlify; no pinned URL.
GENESIS_DATABASE_URL=
GENESIS_DATABASE_CA=
# Random 32+ byte hex secret, generated by an operator in the approved environment.
GENESIS_RATE_SECRET=
# Comma-separated owner-verified EOA administrator wallets; no invented address.
GENESIS_ADMIN_WALLETS=
# Optional owner-nominated wallets permitted to prove control privately while
# public registration is closed. This does NOT grant administrator permissions.
GENESIS_PRIVATE_VERIFICATION_WALLETS=
# Private owner-approved partner key -> retained evidence digest. Empty by default.
GENESIS_APPROVED_PARTNERS={}
